{
  "manifest_version": 3,
  "name": "Aurora Wallet",
  "short_name": "Aurora",
  "version": "1.0.0",
  "description": "Non-custodial Ethereum & Solana wallet with live market charts. Keys are encrypted and never leave your device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aurora Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
